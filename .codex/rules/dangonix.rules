# Shell command rules for Codex, mirroring the Bash rules of .claude/settings.json
# (allow = run without asking, prompt = ask, forbidden = never). Keep both
# in sync; from c1q13 both are generated from the dangonix command table.
prefix_rule(pattern=["scripts/check"], decision="allow")
prefix_rule(pattern=["scripts/quest-verify"], decision="allow")
prefix_rule(pattern=["scripts/closure-diff"], decision="allow")
prefix_rule(pattern=["scripts/next-version"], decision="allow")
prefix_rule(pattern=["scripts/lint-docs"], decision="allow")
prefix_rule(pattern=["scripts/review"], decision="allow")
prefix_rule(pattern=["scripts/lint-commits"], decision="allow")
prefix_rule(pattern=["nix", "build"], decision="allow")
prefix_rule(pattern=["nix", "eval"], decision="allow")
prefix_rule(pattern=["nix", "fmt"], decision="allow")
prefix_rule(pattern=["nix", "flake", "check"], decision="allow")
prefix_rule(pattern=["nix", "flake", "show"], decision="allow")
prefix_rule(pattern=["nix", "flake", "metadata"], decision="allow")
prefix_rule(pattern=["nix", "flake", "lock"], decision="allow")
prefix_rule(pattern=["nix", "path-info"], decision="allow")
prefix_rule(pattern=["nix", "derivation", "show"], decision="allow")
prefix_rule(pattern=["nix", "log"], decision="allow")
prefix_rule(pattern=["nix", "store", "diff-closures"], decision="allow")
prefix_rule(pattern=["nix-diff"], decision="allow")
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "rm"], decision="allow")
prefix_rule(pattern=["git", "mv"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "tag"], decision="allow")
prefix_rule(pattern=["git", "rev-parse"], decision="allow")
prefix_rule(pattern=["git", "stash", "create"], decision="allow")
prefix_rule(pattern=["git", "worktree"], decision="allow")
prefix_rule(pattern=["git", "restore"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["jq"], decision="allow")
prefix_rule(pattern=["mktemp"], decision="allow")
prefix_rule(pattern=["sudo"], decision="prompt")
prefix_rule(pattern=["nixos-rebuild"], decision="prompt")
prefix_rule(pattern=["home-manager", "switch"], decision="prompt")
prefix_rule(pattern=["nix", "flake", "update"], decision="prompt")
prefix_rule(pattern=["just", "switch"], decision="prompt")
prefix_rule(pattern=["just", "home-switch"], decision="prompt")
prefix_rule(pattern=["nix", "run", ".#switch"], decision="prompt")
prefix_rule(pattern=["nix", "run", ".#home-switch"], decision="prompt")
prefix_rule(pattern=["kit-profile", "switch"], decision="prompt")
prefix_rule(pattern=["kit-theme", "switch"], decision="prompt")
prefix_rule(pattern=["foundry"], decision="prompt")
prefix_rule(pattern=["foundry-stop"], decision="prompt")
prefix_rule(pattern=["foundry-restart"], decision="prompt")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "."], decision="forbidden")
prefix_rule(pattern=["git", "commit", "-a"], decision="forbidden")
prefix_rule(pattern=["git", "push"], decision="forbidden")
