{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "top=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$top/.codex/rules/dangonix.rules\" ] || exit 0; \"$top/scripts/hooks/git-guard\" || exit 2"
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/dangonix/hooks/bash-guard\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "top=$(git rev-parse --show-toplevel 2>/dev/null) && \"$top/scripts/context-watch\" || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "top=$(git rev-parse --show-toplevel 2>/dev/null) && \"$top/scripts/quest-stop\" || exit 0"
          }
        ]
      }
    ]
  }
}
