#!/usr/bin/env bash
# PreToolUse(Bash): git commit/tag only on branch `redesign`; never git push.
# Exit 2 blocks the command; settings run this as `… || exit 2`, so any
# failure here (missing jq, crash) also blocks.
set -euo pipefail
input=$(cat)
cmd=$(jq -r '.tool_input.command // ""' <<<"$input")
cwd=$(jq -r '.cwd // "."' <<<"$input")
git_sub='(^|[;&|(]|\s)git(\s+-[Cc]\s+\S+|\s+--\S+)*\s+'
if grep -qP "${git_sub}push\b" <<<"$cmd"; then
  echo "git push is denied" >&2; exit 2
fi
if grep -qP "${git_sub}(commit|tag)\b" <<<"$cmd"; then
  branch=$(git -C "$cwd" branch --show-current)
  if [[ "$branch" != redesign ]]; then
    echo "git commit/tag only on branch redesign (current: ${branch:-detached})" >&2; exit 2
  fi
fi
exit 0
