{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(dangonix --dry *)",
      "Bash(dangonix check)",
      "Bash(dangonix check *)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(nixos-rebuild *)",
      "Bash(home-manager switch *)",
      "Bash(nix flake update *)",
      "Bash(nix flake update)",
      "Bash(just switch)",
      "Bash(just home-switch)",
      "Bash(nix run .#switch)",
      "Bash(nix run .#home-switch)",
      "Bash(kit-profile switch *)",
      "Bash(kit-theme switch *)",
      "Bash(foundry)",
      "Bash(foundry-stop)",
      "Bash(foundry-restart)",
      "Bash(dangonix switch*)",
      "Bash(dangonix update*)",
      "Bash(dangonix theme*)",
      "Bash(dangonix foundry start*)",
      "Bash(dangonix foundry stop*)",
      "Bash(dangonix foundry restart*)",
      "Bash(dangonix foundry open*)",
      "Bash(dangonix foundry import*)",
      "Bash(dangonix foundry upgrade*)",
      "Bash(dangonix foundry add*)",
      "Bash(dangonix foundry remove*)",
      "Bash(nix run . -- switch*)",
      "Bash(nix run . -- update*)",
      "Bash(nix run . -- theme*)",
      "Bash(nix run . -- foundry start*)",
      "Bash(nix run . -- foundry stop*)",
      "Bash(nix run . -- foundry restart*)",
      "Bash(nix run . -- foundry open*)",
      "Bash(nix run . -- foundry import*)",
      "Bash(nix run . -- foundry upgrade*)",
      "Bash(nix run . -- foundry add*)",
      "Bash(nix run . -- foundry remove*)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git checkout .)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git restore -- .)",
      "Bash(git commit -a *)",
      "Bash(git commit --amend*)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Edit(**/hardware-configuration.nix)",
      "Edit(**/.git/**)",
      "Edit(**/scripts/hooks/**)"
    ],
    "additionalDirectories": [
      "/nix/store",
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/git-guard || exit 2"
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] || \"$HOME/.config/dangonix/hooks/bash-guard\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/context-watch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/quest-stop"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "nixos"
  ],
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": false
    }
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/nix"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.local/share/keyrings",
        "~/.1password"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "cache.nixos.org",
        "*.cachix.org"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ]
    }
  }
}
