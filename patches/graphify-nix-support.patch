+def _semantic_neighbors(G: nx.Graph, node: str) -> list[str]:
+    """Rank and bound noisy Nix occurrence edges without pruning the graph."""
+    ranked: list[tuple[float, float, float, str]] = []
+    for neighbor in G.neighbors(node):
+        raw = G[node][neighbor]
+        attrs = (
+            max(raw.values(), key=lambda item: float(item.get("weight", 1.0)))
+            if isinstance(G, (nx.MultiGraph, nx.MultiDiGraph))
+            else raw
+        )
+        ranked.append(
+            (
+                float(attrs.get("weight", 1.0)),
+                float(G.nodes[neighbor].get("semantic_rank", 0.0)),
+                float(G.degree(neighbor, weight="weight")),
+                neighbor,
+            )
+        )
+    ranked.sort(key=lambda item: (-item[0], -item[1], -item[2], str(item[3])))
+    neighbors = [item[3] for item in ranked]
+    is_nix = G.nodes[node].get("lang") == "nix" or any(
+        G.nodes[neighbor].get("lang") == "nix" for neighbor in neighbors
+    )
+    if is_nix and len(neighbors) > 32:
+        return neighbors[:32]
+    return neighbors
+
