#!/usr/bin/env bash
# Print the next semantic version from Conventional Commits since the last
# `vX.Y.Z` tag (or, before the first tag, the last `vX.Y.Z …` commit subject).
# While 0.x: a breaking change or feat bumps the minor, anything else the patch.
# From 1.0.0: breaking → major, feat → minor, else patch.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if last=$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null); then
  range="$last..HEAD"
else
  base=$(git log --format='%H %s' | grep -m1 -P '^\S+ v\d+\.\d+\.\d+\b') ||
    { echo "next-version: no version tag or vX.Y.Z commit found" >&2; exit 1; }
  last=$(grep -oP 'v\d+\.\d+\.\d+' <<<"${base#* }" | head -n1)
  range="${base%% *}..HEAD"
fi
IFS=. read -r major minor patch <<<"${last#v}"

subjects=$(git log --format=%s "$range")
bodies=$(git log --format=%b "$range")
[[ -n $subjects ]] || { echo "next-version: no commits since $last" >&2; exit 1; }

breaking=0 feat=0
grep -qP '^\w+(\([^)]*\))?!:' <<<"$subjects" && breaking=1
grep -q '^BREAKING CHANGE:' <<<"$bodies" && breaking=1
grep -qP '^feat(\([^)]*\))?!?:' <<<"$subjects" && feat=1

if ((major == 0)); then
  if ((breaking || feat)); then minor=$((minor + 1)) patch=0; else patch=$((patch + 1)); fi
elif ((breaking)); then
  major=$((major + 1)) minor=0 patch=0
elif ((feat)); then
  minor=$((minor + 1)) patch=0
else
  patch=$((patch + 1))
fi
echo "v$major.$minor.$patch"
