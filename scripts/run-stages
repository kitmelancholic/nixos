#!/usr/bin/env bash
# Run stages until one needs me.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
while true; do
  claude -p "/next-stage" --permission-mode acceptEdits > /dev/null
  last=$(grep -E '^## stage' docs/progress.md | tail -n 1)
  case "$last" in
    *"— done"*) continue ;;
    *) notify-send "kitOS redesign" "$last"; echo "$last"; break ;;
  esac
done
