#!/usr/bin/env bash
# PreToolUse(Bash) tripwire: git commit/tag only in this checkout on branch
# `redesign`; never git push. Regex over command text is not security: the
# ref guard (scripts/hooks/ref-guard, a git hook) is the real local check.
# Claude Code (.claude/settings.json) and Codex (.codex/hooks.json) both run
# it before every shell command, with the same JSON input.
# Exit 2 blocks the command; settings run this as `… || exit 2`, so any
# failure here (missing jq, crash) also blocks.
set -euo pipefail
input=$(cat)
cmd=$(jq -r '.tool_input.command // ""' <<<"$input")
cwd=$(jq -r '.cwd // "."' <<<"$input")
here=$(cd "$(dirname "$0")/../.." && pwd -P)
deny() {
  echo "git-guard: $1" >&2
  exit 2
}

grep -qP '\bgit\b' <<<"$cmd" || exit 0
grep -qP '\bgit\b.*\bpush\b' <<<"$cmd" && deny "git push is denied"
grep -qP -- '--no-verify|\b(CLAUDECODE|DANGONIX_AGENT)\b|core\.hooksPath|\.git/hooks' <<<"$cmd" &&
  deny "hook bypass is denied"
if grep -qP '\bgit\b[^;&|]*\b(commit|tag)\b' <<<"$cmd"; then
  # Anything that can point git at another repository or branch.
  grep -qP -- '\s-C\s|--git-dir|--work-tree|\bGIT_(DIR|WORK_TREE)\b|(^|[;&|(]|\s)cd\s|\b(checkout|switch)\b|\b(bash|sh|eval|xargs)\b' <<<"$cmd" &&
    deny "git commit/tag must be a plain command in the checkout"
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || deny "not in a git repository"
  [[ $(cd "$top" && pwd -P) == "$here" ]] || deny "git commit/tag only in $here"
  branch=$(git -C "$top" branch --show-current)
  [[ $branch == redesign ]] || deny "git commit/tag only on branch redesign (current: ${branch:-detached})"
fi
exit 0
