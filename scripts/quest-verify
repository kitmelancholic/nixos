#!/usr/bin/env bash
# Mechanical gate for one quest: full flake check, then the oracle in the mode
# named by the quest's meta line in docs/tasks.md.  Usage: quest-verify <id>
set -euo pipefail
id=${1:?usage: quest-verify <quest id>}
root=$(git rev-parse --show-toplevel)
cd "$root"

meta=$(awk -v id="$id" '
  $0 ~ "^## " id " " { found = 1; next }
  found && /^meta:/   { sub(/^meta: */, ""); print; exit }
  found && /^## /     { exit }
' docs/tasks.md)
[[ -n $meta ]] || { echo "quest-verify: no meta line for $id" >&2; exit 2; }

get() { tr ' ' '\n' <<<"$meta" | sed -n "s/^$1=//p"; }
mode=$(get diff)
removed=$(get removed)
leaves=$(get leaves)

echo "== $id: nix flake check"
if ! nix flake check --no-write-lock-file > /tmp/quest-verify.$$.log 2>&1; then
  tail -n 40 /tmp/quest-verify.$$.log; rm -f /tmp/quest-verify.$$.log; exit 1
fi
rm -f /tmp/quest-verify.$$.log

case $mode in
  baseline | source-only)
    echo "== $id: no oracle in mode $mode" ;;
  none)
    args=(--assert-same)
    if [[ -n $removed ]]; then
      IFS=, read -ra ids <<<"$removed"
      args+=(--removed "${ids[@]}")
    fi
    echo "== $id: closure-diff ${args[*]} HEAD"
    scripts/closure-diff "${args[@]}" HEAD ;;
  leaves)
    echo "== $id: closure-diff --names HEAD"
    mapfile -t changed < <(scripts/closure-diff --names HEAD)
    IFS=, read -ra globs <<<"$leaves"
    fail=0
    for name in "${changed[@]}"; do
      ok=0
      for g in "${globs[@]}"; do
        # shellcheck disable=SC2053  # glob match is intended
        [[ $name == ${g%\?} ]] && { ok=1; break; }
      done
      ((ok)) || { echo "unexpected change: $name"; fail=1; }
    done
    for g in "${globs[@]}"; do
      [[ $g == *\? ]] && continue
      hit=0
      for name in "${changed[@]}"; do
        # shellcheck disable=SC2053
        [[ $name == $g ]] && { hit=1; break; }
      done
      ((hit)) || { echo "expected change missing: $g"; fail=1; }
    done
    exit "$fail" ;;
  *)
    echo "quest-verify: unknown diff mode '$mode'" >&2; exit 2 ;;
esac
