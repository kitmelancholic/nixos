#!/usr/bin/env bash
# Autopilot: run quests from docs/tasks.md one fresh Claude Code session at a
# time, with the model and effort from each quest's meta line, until a journal
# entry is anything but `виконано`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

next_quest() {
  grep -oP '^## \Kc\d+q\d+(?= )' docs/tasks.md | while read -r id; do
    grep -q "^## $id — виконано" docs/progress.md || { echo "$id"; break; }
  done
}

for _ in $(seq 25); do
  id=$(next_quest)
  [[ -n $id ]] || { notify-send "dangoNix" "Campaign complete"; exit 0; }
  meta=$(awk -v id="$id" '$0 ~ "^## " id " " {f=1; next} f && /^meta:/ {print; exit}' docs/tasks.md)
  model=$(grep -oP 'model=\K\S+' <<<"$meta")
  effort=$(grep -oP 'effort=\K\S+' <<<"$meta")
  before=$(git rev-parse HEAD)
  echo "== $id ($model, $effort)"
  claude -p "/quest $id" --model "$model" --effort "$effort" \
    --permission-mode acceptEdits > /dev/null || {
    notify-send "dangoNix" "$id: claude exited non-zero"; exit 1; }
  [[ $(git rev-parse HEAD) != "$before" ]] || {
    notify-send "dangoNix" "$id: no new commit"; exit 1; }
  last=$(grep -E '^## c[0-9]+q[0-9]+ — ' docs/progress.md | tail -n 1)
  case $last in
    *"— виконано"*) continue ;;
    *) notify-send "dangoNix" "$last"; echo "$last"; exit 0 ;;
  esac
done
notify-send "dangoNix" "Stopped after 25 quests"
