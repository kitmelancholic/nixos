#!/usr/bin/env bash
# Autopilot: run quests from docs/tasks.md one fresh agent session at a time,
# with the tier and effort from each quest's meta line. Whenever a quest waits
# for the GM, the GM answers here instead of in the journal:
# - `запит: scope|permission` (the agent knows the exact change, in
#   .campaign/<id>.request.patch): the judge gives a recommendation, the GM
#   answers y/n; on y this script applies and commits the patch and retries
#   on the quest's own tier;
# - `хід майстра`: the checklist is shown; on y this script records
#   `виконано` and carries on;
# - any other `провалений кидок`: the GM types a one-line decision, the
#   cleric retries.
# An agent that exits without a journal entry is retried once on its own
# tier. Without a terminal (or with --no-ask) every such case stops the run.
#   campaign [--agent claude|codex] [--judge claude|codex] [--no-ask]
# --agent  the hero's CLI (default claude); --judge  the CLI behind
# scripts/review (default: the hero's). Models per tier: AGENTS.md. Each
# attempt's log goes to .campaign/<id>.<n>.json, one line per attempt to
# .campaign/runs.tsv (both gitignored).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
agent=claude
judge=
ask=1
while [[ ${1:-} == --* ]]; do
  case $1 in
  --agent | --judge)
    [[ ${2:-} == claude || ${2:-} == codex ]] || {
      echo "campaign: $1 needs claude or codex" >&2
      exit 2
    }
    declare "${1#--}=$2"
    shift 2
    ;;
  --no-ask)
    ask=0
    shift
    ;;
  *)
    echo "campaign: unknown flag $1" >&2
    exit 2
    ;;
  esac
done
export DANGONIX_JUDGE=${judge:-$agent}
mkdir -p .campaign
limit=${QUEST_TIMEOUT:-3h}
{ : </dev/tty; } 2>/dev/null || ask=0

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "dangoNix" "$1" 2>/dev/null || true
  fi
}

stop() {
  notify "$1"
  echo "$1"
  exit "${2:-1}"
}

# Ask the GM on the terminal; the answer goes to $reply. Without a terminal
# the run stops with the question as its message.
prompt() {
  ((ask)) || stop "$1" 0
  notify "$1"
  reply=
  read -r -p "$1 " reply </dev/tty || stop "$1" 0
}

next_quest() {
  grep -oP '^## \Kc\d+[qs]\d+(?= )' docs/tasks.md | while read -r id; do
    grep -q "^## $id — виконано" docs/progress.md || {
      echo "$id"
      break
    }
  done
}

# The quest's last journal entry, heading included.
last_entry() {
  awk -v id="$1" '
    $0 ~ "^## " id " (—|-) " { buf = $0 "\n"; on = 1; next }
    /^## / { on = 0 }
    on { buf = buf $0 "\n" }
    END { printf "%s", buf }' docs/progress.md
}

# The quest's state from its last journal entry: `new` (none yet), `done`,
# `retry` (the GM answered it: a `благословення` entry, or any text the GM
# wrote below the entry's closing `agent:` line), or `gm` (it waits for the
# GM).
quest_state() {
  last_entry "$1" | awk '
    NR == 1 { kind = $0; sub(/^## [^ ]+ (—|-) /, "", kind); next }
    /^agent:/ { after = 1; next }
    after && NF { gm = 1 }
    END {
      if (kind == "") print "new"
      else if (kind == "виконано") print "done"
      else if (kind == "благословення" || gm) print "retry"
      else print "gm"
    }'
}

# Each CLI has its own skill syntax; both load .agents/skills/quest.
invoke() {
  case $agent in
  claude) echo "/quest $1" ;;
  codex) echo "\$quest $1" ;;
  esac
}

# Append the GM's answer below the quest's last entry (the end of the
# journal: the quest runs last) and commit only the journal and the given
# paths.
answer() {
  local id=$1 subject=$2 text=$3
  shift 3
  printf '%s\n' "$text" >>docs/progress.md
  if ! git add -- docs/progress.md "$@" ||
    ! git commit -q -m "chore($id): $subject" -- docs/progress.md "$@"; then
    stop "$id: could not commit the GM's answer (see git status)"
  fi
}

# `запит: scope|permission`: judge, then the GM. On y the patch is applied
# and committed by this script, so protected files (.claude/settings.json)
# change only with the GM's y, never by the agent.
request() {
  local id=$1 kind=$2 patch=.campaign/$1.request.patch verdict p
  local -a clean=() dirty=()
  echo
  echo "== $id просить розширити: $kind"
  last_entry "$id" | sed -n '2,$p' | grep -v '^agent:'
  [[ -s $patch ]] || {
    prompt "$id: немає $patch. Рішення одним рядком (порожньо = стоп):"
    [[ -n $reply ]] || stop "$id: waiting for the GM" 0
    answer "$id" "рішення GM" "GM (campaign, $(date +%F)): $reply"
    return
  }
  echo "-- $patch"
  cat "$patch"
  git apply --check --recount "$patch" 2>/dev/null || {
    echo "-- патч не накладається на робоче дерево"
    prompt "$id: рішення одним рядком (порожньо = стоп):"
    [[ -n $reply ]] || stop "$id: waiting for the GM" 0
    answer "$id" "рішення GM" "GM (campaign, $(date +%F)): $reply"
    return
  }
  echo "-- суддя ($DANGONIX_JUDGE)"
  verdict=$(scripts/review --request "$id") || verdict="(суддя не відповів, див. .campaign/$id.request.review.json)"
  echo "$verdict"
  prompt "Розширити скоуп $id? [y/n]"
  case $reply in
  y | Y | т | Т)
    # A path that already holds uncommitted work is patched but left
    # uncommitted, so the GM's commit never carries the quest's work.
    while read -r p; do
      if [[ -z $(git status --porcelain -- "$p") ]]; then
        clean+=("$p")
      else
        dirty+=("$p")
      fi
    done < <(git apply --numstat --recount "$patch" | cut -f3)
    git apply --recount "$patch" || stop "$id: git apply failed"
    ((${#dirty[@]} == 0)) || echo "$id: не закомічено (там уже є робота квесту): ${dirty[*]}"
    mv "$patch" "$patch.applied"
    answer "$id" "розширено скоуп" \
      "GM (campaign, $(date +%F)): так, $kind: патч $patch.applied; retry: own tier" \
      "${clean[@]}"
    ;;
  *)
    prompt "Чому ні / що натомість (порожньо = стоп):"
    [[ -n $reply ]] || stop "$id: waiting for the GM" 0
    mv "$patch" "$patch.rejected"
    answer "$id" "рішення GM" "GM (campaign, $(date +%F)): ні — $reply"
    ;;
  esac
}

# `хід майстра`: the GM works through the checklist, then answers.
gm_turn() {
  local id=$1
  echo
  echo "== $id: хід майстра"
  last_entry "$id" | sed -n '2,$p' | grep -v '^agent:'
  prompt "Пройди чекліст. Усе добре? [y/n]"
  case $reply in
  y | Y | т | Т)
    printf '\n## %s — виконано\nGM перевірив чекліст у campaign (%s).\n' "$id" "$(date +%F)" >>docs/progress.md
    git commit -q -m "chore($id): виконано" -- docs/progress.md ||
      stop "$id: could not commit the journal (see git status)"
    ;;
  *)
    prompt "Що не так (одним рядком, порожньо = стоп):"
    [[ -n $reply ]] || stop "$id: waiting for the GM" 0
    answer "$id" "рішення GM" "GM (campaign, $(date +%F)): $reply"
    ;;
  esac
}

# Any other entry that waits for the GM: a one-line decision.
gm_decision() {
  local id=$1
  echo
  last_entry "$id"
  prompt "Рішення для $id одним рядком (порожньо = стоп):"
  [[ -n $reply ]] || stop "$id: waiting for the GM" 0
  answer "$id" "рішення GM" "GM (campaign, $(date +%F)): $reply"
}

attempt=0
declare -A crashed=()
while ((attempt < ${QUEST_ATTEMPTS:-25})); do
  id=$(next_quest)
  [[ -n $id ]] || stop "Campaign complete" 0
  meta=$(awk -v id="$id" '$0 ~ "^## " id " " {f=1; next} f && /^meta:/ {print; exit}' docs/tasks.md)
  tier=$(grep -oP 'tier=\K\S+' <<<"$meta")
  effort=$(grep -oP 'effort=\K\S+' <<<"$meta")
  arg=$id
  state=$(quest_state "$id")
  if [[ $state == gm ]]; then
    entry=$(last_entry "$id")
    kind=$(grep -oP '^запит:\s*\K(scope|permission)' <<<"$entry" | tail -n 1)
    if [[ -n $kind ]]; then
      request "$id" "$kind"
    elif [[ $(head -n 1 <<<"$entry") == *"хід майстра"* ]]; then
      gm_turn "$id"
    else
      gm_decision "$id"
    fi
    continue
  fi
  # A new quest on a dirty tree fails on someone else's changes; a retry (or
  # the rerun after a crash) keeps the failed run's uncommitted work on purpose.
  [[ $state != new || -n ${crashed[$id]:-} || -z $(git status --porcelain --untracked-files=no) ]] ||
    stop "Uncommitted changes: commit or stash them first"
  if [[ $state == retry ]]; then
    arg="retry $id"
    # A widened scope or permission was the quest's fault, not the hero's:
    # the retry stays on the quest's tier. Any other answer goes to the cleric.
    last_entry "$id" | grep -q 'retry: own tier$' || tier=cleric
  fi
  attempt=$((attempt + 1))
  n=1
  while [[ -e .campaign/$id.$n.json ]]; do n=$((n + 1)); done
  log=.campaign/$id.$n.json
  model=$(scripts/agent model "$agent" "$tier")
  before=$(git rev-parse HEAD)
  journal=$(last_entry "$id" | md5sum)
  echo "== $id ($agent $model, $effort) → $log"
  start=$(date +%s)
  timeout --foreground "$limit" scripts/agent run "$agent" "$tier" "$effort" \
    "$log" "$(invoke "$arg")"
  rc=$?
  denied=0 cost=
  if [[ $agent == claude ]]; then
    denied=$(jq '.permission_denials | length' "$log" 2>/dev/null || echo "?")
    cost=$(jq -r '.total_cost_usd // empty' "$log" 2>/dev/null)
    # The denials themselves: a new one is a gap to close with
    # `запит: permission`, not a reason to babysit.
    jq -r '.permission_denials[]? | "  denied \(.tool_name): \(.tool_input.command // .tool_input.file_path // "" | gsub("\n"; " ") | .[0:120])"' \
      "$log" 2>/dev/null | head -n 10
  fi
  outcome=$(last_entry "$id" | head -n 1 | sed -E 's/^## [^ ]+ (—|-) //')
  [[ $(last_entry "$id" | md5sum) != "$journal" ]] || outcome="(no entry)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%sm\t%s\t%s\t%s\n' "$(date +%FT%T)" \
    "$id" "$n" "$agent" "$model" "$tier" "$rc" "$((($(date +%s) - start) / 60))" \
    "${cost:--}" "$denied" "$outcome" >>.campaign/runs.tsv
  ((rc == 124)) && stop "$id: timed out after $limit"
  # No journal entry: the agent crashed, ran out of turns or context. Rerun
  # once on the same tier; a second time it is the GM's.
  if [[ $outcome == "(no entry)" || $(git rev-parse HEAD) == "$before" ]]; then
    [[ -z ${crashed[$id]:-} ]] ||
      stop "$id: $agent exited $rc with no new commit twice ($denied permission denials, see $log)"
    crashed[$id]=1
    echo "$id: $agent exited $rc with no new commit; one rerun on $tier"
    continue
  fi
  case $outcome in
  виконано)
    [[ $denied == 0 ]] || echo "$id: $denied permission denials (see $log)"
    ;;
  *) echo "$id: $outcome" ;;
  esac
done
stop "Stopped after ${QUEST_ATTEMPTS:-25} agent runs" 0
