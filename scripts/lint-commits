#!/usr/bin/env bash
# Conventional Commits gate (docs/tasks.md, "Commits").
#   lint-commits <rev-range>     check every non-merge commit in the range
#   lint-commits --msg-file F    check one message (git commit-msg hook)
# Commits that are ancestors of $LINT_COMMITS_SINCE (the last commit before the
# convention) are exempt.
set -euo pipefail
since=${LINT_COMMITS_SINCE:-c5c5ea34b2e761915c426778a1a70e7057928c62}
types='feat|fix|refactor|test|chore|docs|ci|build|perf|style|revert'

check() { # $1 = label, stdin = full message
  local msg subject
  msg=$(grep -v '^#' || true)
  subject=$(head -n1 <<<"$msg")
  [[ $subject =~ ^(Merge|fixup!|squash!) ]] && return 0
  if ! grep -qP "^($types)(\([a-z0-9-]+\))?!?: \S" <<<"$subject"; then
    echo "lint-commits: $1: '$subject' is not '<type>(<scope>)[!]: <subject>' ($types)" >&2
    return 1
  fi
  if grep -qP '^\w+(\([^)]*\))?!:' <<<"$subject" && ! grep -q '^BREAKING CHANGE: ' <<<"$msg"; then
    echo "lint-commits: $1: '!' needs a 'BREAKING CHANGE: …' line in the body" >&2
    return 1
  fi
}

if [[ ${1:-} == --msg-file ]]; then
  check "message" <"${2:?usage: lint-commits --msg-file <file>}"
  exit
fi

range=${1:?usage: lint-commits <rev-range> | --msg-file <file>}
exclude=()
git cat-file -e "$since^{commit}" 2>/dev/null && exclude=(--not "$since")
fail=0
while read -r sha; do
  git log -1 --format=%B "$sha" | check "${sha:0:7}" || fail=1
done < <(git rev-list --no-merges "$range" "${exclude[@]}")
((fail == 0)) && echo "lint-commits: ok"
exit "$fail"
